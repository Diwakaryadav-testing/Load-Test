            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">//// Example Groovy script to format the JSON object
//def extractedJson = vars.get(&quot;flashsaleId&quot;) // Get the extracted JSON
//extractedJson = extractedJson.replaceAll(/^\[|\]$/, &apos;&apos;) // Remove square brackets
//vars.put(&quot;formattedObject&quot;, extractedJson) // Save the formatted JSON back to variables



// Assuming &apos;formattedObject&apos; is the variable name where the extracted object JSON string is stored
def extractedObject = vars.get(&quot;flashsaleId&quot;)

// Static part of your JSON payload as a Groovy map (which translates to JSON)
def payload = [
    cartOf: &quot;flash-sale&quot;,
    cart: [], // Initially empty, will add the dynamic object here
    amount: 1.1
]

// Convert the extracted object from JSON string to a Map
def extractedObjectMap = new groovy.json.JsonSlurper().parseText(extractedObject)

// Add the extracted object to the cart array
payload.cart.add(extractedObjectMap)

// Convert the full payload back to JSON string
def fullPayloadJson = new groovy.json.JsonBuilder(payload).toPrettyString()

// Store the full JSON payload in a JMeter variable to use in an HTTP Request
vars.put(&quot;fullPayload&quot;, fullPayloadJson)

</stringProp>
          </JSR223PostProcessor>

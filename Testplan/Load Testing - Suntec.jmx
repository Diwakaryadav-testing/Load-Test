 WebElement text = driver.findElement(By.xpath(&quot;//*[contains(text(), &apos;OTP/TAC: &apos;)]&quot;));
 String value=text.getText();

 log.info(value);

String otpNumber = extractOTPNumber(value);

   private static String extractOTPNumber(String text) {
        String pattern = &quot;OTP/TAC: (\\d+)&quot;;
        Pattern r = Pattern.compile(pattern);
        Matcher m = r.matcher(text);
        if (m.find()) {
            return m.group(1);
        }
        return null; // Handle if no match is found
    }
 
log.info(otpNumber);

